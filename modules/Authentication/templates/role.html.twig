{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ role.code }} — {{ 'authentication.role.title'|trans }}{% endblock %}

{% block content %}
    {# The code is on display, never in a field: renaming it is structurally
       impossible, which is what keeps the admin anchor safe. #}
    <header class="page-header">
        <h1>{{ role.label }} <code class="entity-code">{{ role.code }}</code></h1>
    </header>

    <section class="panel">
        <form method="post" action="{{ url('authentication.role_update', {'id': role.id}) }}">
            {{ csrf_field() }}

            <p class="field">
                <label for="label">{{ 'authentication.role.label'|trans }}</label>
                <input type="text" id="label" name="label" value="{{ role.label }}" required>
            </p>

            <h2>{{ 'authentication.role.permissions'|trans }}</h2>
            {% for group, permissions in groups %}
                <fieldset>
                    <legend>{{ group }}</legend>
                    <div class="choice-list">
                        {% for permission in permissions %}
                            <label class="choice">
                                <input type="checkbox" name="permissions[]" value="{{ permission.code }}"
                                    {%- if permission.code in held %} checked{% endif %}>
                                {{ permission.label|trans }} <code>{{ permission.code }}</code>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
            {% endfor %}

            {% if unknown is not empty %}
                {# Stored but no longer declared (a module was removed): inert at
                   runtime, shown for honesty, gone at the next save. #}
                <p class="field-hint">{{ 'authentication.role.unknown'|trans }}
                    {% for code in unknown %}<code>{{ code }}</code> {% endfor %}
                </p>
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="primary">{{ 'authentication.role.save'|trans }}</button>
            </div>
        </form>
    </section>

    {% if not isAdmin %}
        <section class="danger-zone">
            <h2>{{ 'authentication.role.danger'|trans }}</h2>
            {# Deleting a role revokes it from every holder in every company. #}
            <p>{{ 'authentication.role.delete_warning'|trans }}</p>
            <form method="post" action="{{ url('authentication.role_delete', {'id': role.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="danger">{{ 'authentication.role.delete'|trans }}</button>
            </form>
        </section>
    {% else %}
        <p class="field-hint">{{ 'authentication.role.admin_note'|trans }}</p>
    {% endif %}
{% endblock %}
