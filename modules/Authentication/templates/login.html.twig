{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.login.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'authentication.login.title'|trans }}</h1>

    <form method="post" action="{{ url('authentication.login_submit') }}">
        {{ csrf_field() }}
        {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}">{% endif %}

        <p>
            <label for="identifier">{{ 'authentication.login.email'|trans }}</label><br>
            <input type="email" id="identifier" name="identifier" autocomplete="username" required>
        </p>
        <p>
            <label for="password">{{ 'authentication.login.password'|trans }}</label><br>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
        </p>

        <button type="submit">{{ 'authentication.login.submit'|trans }}</button>
    </form>
{% endblock %}
