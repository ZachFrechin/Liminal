{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.login.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'authentication.login.title'|trans }}</h1>

    <form class="form-stack" method="post" action="{{ url('authentication.login_submit') }}">
        {{ csrf_field() }}
        {% if redirect %}<input type="hidden" name="redirect" value="{{ redirect }}">{% endif %}

        <p class="field">
            <label for="identifier">{{ 'authentication.login.email'|trans }}</label>
            <input type="email" id="identifier" name="identifier" autocomplete="username" required>
        </p>
        <p class="field">
            <label for="password">{{ 'authentication.login.password'|trans }}</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>
        </p>

        <div class="form-actions">
            <button type="submit" class="primary">{{ 'authentication.login.submit'|trans }}</button>
        </div>
    </form>
{% endblock %}
