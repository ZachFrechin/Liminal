{# Rendered straight from the POST, with no-store: this response body is the
   only copy of the secret that will ever exist in the clear. No redirect, no
   session, no log — leaving this page loses it, by design. #}
{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ titleKey|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ url('authentication.user', {'id': userId}) }}">{{ 'authentication.user.back_to_user'|trans }}</a>
{% endblock %}

{% block content %}
    <h1>{{ titleKey|trans }}</h1>

    <p>{{ 'authentication.user.password_for'|trans({'email': email}) }}</p>
    <p><code class="one-time-password">{{ password }}</code></p>
    <p role="alert">{{ 'authentication.user.password_once'|trans }}</p>

{% endblock %}
