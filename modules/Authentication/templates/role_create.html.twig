{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.role.create_title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'authentication.role.create_title'|trans }}</h1>

    <form method="post" action="{{ url('authentication.role_create_submit') }}" class="form-card">
        {{ csrf_field() }}

        <p class="field">
            <label for="code">{{ 'authentication.role.code'|trans }}</label>
            <input type="text" id="code" name="code" required pattern="[a-z][a-z0-9_]*">
            <span class="field-hint">{{ 'authentication.role.code_hint'|trans }}</span>
        </p>
        <p class="field">
            <label for="label">{{ 'authentication.role.label'|trans }}</label>
            <input type="text" id="label" name="label" required>
        </p>

        <h2>{{ 'authentication.role.permissions'|trans }}</h2>
        {% for group, permissions in groups %}
            <fieldset>
                <legend>{{ group }}</legend>
                <div class="choice-list">
                    {% for permission in permissions %}
                        <label class="choice">
                            <input type="checkbox" name="permissions[]" value="{{ permission.code }}">
                            {{ permission.label|trans }} <code>{{ permission.code }}</code>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
        {% endfor %}

        <div class="form-actions">
            <button type="submit" class="primary">{{ 'authentication.role.create_submit'|trans }}</button>
        </div>
    </form>
{% endblock %}
