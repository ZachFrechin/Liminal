{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.role.create_title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'authentication.role.create_title'|trans }}</h1>

    <form method="post" action="{{ url('authentication.role_create_submit') }}">
        {{ csrf_field() }}

        <p>
            <label for="code">{{ 'authentication.role.code'|trans }}</label><br>
            <input type="text" id="code" name="code" required pattern="[a-z][a-z0-9_]*">
            <em>{{ 'authentication.role.code_hint'|trans }}</em>
        </p>
        <p>
            <label for="label">{{ 'authentication.role.label'|trans }}</label><br>
            <input type="text" id="label" name="label" required>
        </p>

        <h2>{{ 'authentication.role.permissions'|trans }}</h2>
        {% for group, permissions in groups %}
            <h3>{{ group }}</h3>
            {% for permission in permissions %}
                <label>
                    <input type="checkbox" name="permissions[]" value="{{ permission.code }}">
                    {{ permission.label|trans }} <code>{{ permission.code }}</code>
                </label><br>
            {% endfor %}
        {% endfor %}

        <button type="submit">{{ 'authentication.role.create_submit'|trans }}</button>
    </form>
{% endblock %}
