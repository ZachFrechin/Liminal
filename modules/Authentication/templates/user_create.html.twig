{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.user.create_title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'authentication.user.create_title'|trans }}</h1>

    {# No password field, ever: the server generates the secret and the next
       page shows it exactly once. #}
    <form method="post" action="{{ url('authentication.user_create_submit') }}">
        {{ csrf_field() }}

        <p>
            <label for="email">{{ 'authentication.user.email'|trans }}</label><br>
            <input type="email" id="email" name="email" required>
        </p>
        <p>
            <label for="display_name">{{ 'authentication.user.display_name'|trans }}</label><br>
            <input type="text" id="display_name" name="display_name">
        </p>

        <button type="submit">{{ 'authentication.user.create_submit'|trans }}</button>
    </form>
{% endblock %}
