{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'authentication.roles.title'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ url('authentication.role_create') }}">{{ 'authentication.roles.create'|trans }}</a>
{% endblock %}

{% block content %}
    <h1>{{ 'authentication.roles.title'|trans }}</h1>

    <table>
        <thead>
            <tr>
                <th>{{ 'authentication.roles.code'|trans }}</th>
                <th>{{ 'authentication.roles.label'|trans }}</th>
                <th>{{ 'authentication.roles.permissions'|trans }}</th>
                <th>{{ 'authentication.roles.grants'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for role in roles %}
                <tr>
                    <td><a href="{{ url('authentication.role', {'id': role.id}) }}">{{ role.code }}</a></td>
                    <td>{{ role.label }}</td>
                    <td>{{ role.permissionCount }}</td>
                    {# The grant count is what a deletion would revoke, across
                       every company at once. #}
                    <td>{{ role.grantCount }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
