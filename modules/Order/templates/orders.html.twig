{% extends '@liminal/layout.html.twig' %}
{% import '@liminal/components.html.twig' as ui %}

{% block title %}{{ 'order.list.title'|trans }}{% endblock %}

{% block page_actions %}
    {% if canManage %}<a href="{{ url('order.create') }}">{{ 'order.list.create'|trans }}</a>{% endif %}
{% endblock %}

{% block content %}
    <h1>{{ 'order.list.title'|trans }}</h1>

    {{ ui.toolbar('order.list', list, schema) }}

    {% if page.total == 0 %}
        {# A filtered list that finds nothing is not an empty list. #}
        {{ ui.empty_state('shopping-cart', list.isFiltered ? 'list.no_match'|trans : 'order.list.empty'|trans) }}
    {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    {{ ui.sortable('order.list', list, schema, 'number', 'order.list.number'|trans) }}
                    {{ ui.sortable('order.list', list, schema, 'party', 'order.list.party'|trans) }}
                    {{ ui.sortable('order.list', list, schema, 'issued', 'order.list.issued'|trans) }}
                    {{ ui.sortable('order.list', list, schema, 'status', 'order.list.status'|trans) }}
                    {{ ui.sortable('order.list', list, schema, 'total', 'order.list.total'|trans) }}
                </tr>
            </thead>
            <tbody>
                {% for order in page.items %}
                    <tr>
                        <td>
                            <a href="{{ url('order.detail', {'id': order.id}) }}">
                                {%- if order.number %}{{ order.number }}{% else %}{{ 'order.status.draft'|trans }}{% endif -%}
                            </a>
                        </td>
                        <td>{{ thirdpartyNames[order.thirdpartyId]|default('—') }}</td>
                        <td>{{ order.issuedOn|date('Y-m-d') }}</td>
                        <td>
                            {# Three states, elseif order matters: invoiced is
                               checked before validated, which is strict. #}
                            {% if order.draft %}
                                <span class="badge">{{ 'order.status.draft'|trans }}</span>
                            {% elseif order.invoiced %}
                                <span class="badge badge-invoiced">{{ 'order.status.invoiced'|trans }}</span>
                            {% else %}
                                <span class="badge badge-validated">{{ 'order.status.validated'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="numeric">{{ order.totalIncl }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {{ ui.pagination('order.list', page, list, schema) }}
    {% endif %}
{% endblock %}
