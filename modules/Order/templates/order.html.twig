{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ order.number ?? 'order.status.draft'|trans }} — {{ 'order.detail.title'|trans }}{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>
            {% if order.number %}<code class="entity-code">{{ order.number }}</code>{% else %}{{ 'order.detail.draft_title'|trans }}{% endif %}
            {% if order.draft %}
                <span class="badge">{{ 'order.status.draft'|trans }}</span>
            {% elseif order.invoiced %}
                <span class="badge badge-invoiced">{{ 'order.status.invoiced'|trans }}</span>
            {% else %}
                <span class="badge badge-validated">{{ 'order.status.validated'|trans }}</span>
            {% endif %}
        </h1>
        <p class="page-header-meta">
            {% if thirdpartyName %}{{ thirdpartyName }}{% endif %}
            <span>{{ 'order.detail.issued'|trans }} {{ order.issuedOn|date('Y-m-d') }}</span>
            {% if order.wantedOn %}<span>{{ 'order.detail.wanted'|trans }} {{ order.wantedOn|date('Y-m-d') }}</span>{% endif %}
            <a href="{{ url('order.pdf', {'id': order.id}) }}">
                {%- if order.draft %}{{ 'order.detail.pdf_proforma'|trans }}{% else %}{{ 'order.detail.pdf'|trans }}{% endif -%}
            </a>
            {% if order.invoiced and order.invoiceId %}
                <a href="{{ url('invoice.detail', {'id': order.invoiceId}) }}">{{ 'order.detail.see_invoice'|trans }}</a>
            {% endif %}
        </p>
    </header>

    {% if canManage and order.draft %}
        <section class="panel">
            <h2>{{ 'order.detail.edit'|trans }}</h2>
            <form method="post" action="{{ url('order.update', {'id': order.id}) }}">
                {{ csrf_field() }}
                <p class="field">
                    <label for="thirdparty_id">{{ 'order.create.thirdparty'|trans }}</label>
                    <select id="thirdparty_id" name="thirdparty_id" required>
                        {% for thirdparty in thirdparties %}
                            <option value="{{ thirdparty.id }}" {% if thirdparty.id == order.thirdpartyId %}selected{% endif %}>{{ thirdparty.name }} ({{ thirdparty.code }})</option>
                        {% endfor %}
                    </select>
                </p>
                <div class="field-row">
                    <p class="field">
                        <label for="issued_on">{{ 'order.create.issued_on'|trans }}</label>
                        <input type="date" id="issued_on" name="issued_on" value="{{ order.issuedOn|date('Y-m-d') }}" required>
                    </p>
                    <p class="field">
                        <label for="wanted_on">{{ 'order.create.wanted_on'|trans }}</label>
                        <input type="date" id="wanted_on" name="wanted_on" value="{{ order.wantedOn ? order.wantedOn|date('Y-m-d') : '' }}">
                    </p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="primary">{{ 'order.detail.save'|trans }}</button>
                </div>
            </form>
        </section>
    {% endif %}

    <section class="panel">
        <h2>{{ 'order.detail.lines'|trans }}</h2>
        <table>
            <thead>
                <tr>
                    <th>{{ 'order.line.label'|trans }}</th>
                    <th>{{ 'order.line.quantity'|trans }}</th>
                    <th>{{ 'order.line.unit_price'|trans }}</th>
                    <th>{{ 'order.line.vat_rate'|trans }}</th>
                    <th>{{ 'order.line.total'|trans }}</th>
                    {% if canManage and order.draft %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td>{{ line.label }}</td>
                        <td class="numeric">{{ line.quantity }}</td>
                        <td class="numeric">{{ line.unitPrice }}</td>
                        <td class="numeric">{{ line.vatRate }}&nbsp;%</td>
                        <td class="numeric">{{ lineTotals[line.id]|default('—') }}</td>
                        {% if canManage and order.draft %}
                            <td>
                                <form method="post" action="{{ url('order.line_remove', {'id': order.id, 'line': line.id}) }}">
                                    {{ csrf_field() }}
                                    <button type="submit">{{ 'order.line.remove'|trans }}</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ canManage and order.draft ? 6 : 5 }}">{{ 'order.detail.no_lines'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>

        {% if canManage and order.draft %}
            <form method="post" action="{{ url('order.line_add', {'id': order.id}) }}" class="form-inline">
                {{ csrf_field() }}
                <p class="field">
                    <label for="line-label">{{ 'order.line.label'|trans }}</label>
                    <input type="text" id="line-label" name="label" maxlength="255" required>
                </p>
                <p class="field">
                    <label for="line-quantity">{{ 'order.line.quantity'|trans }}</label>
                    <input type="text" id="line-quantity" name="quantity" value="1" required>
                </p>
                <p class="field">
                    <label for="line-unit-price">{{ 'order.line.unit_price'|trans }}</label>
                    <input type="text" id="line-unit-price" name="unit_price" required>
                </p>
                <p class="field">
                    <label for="line-vat-rate">{{ 'order.line.vat_rate'|trans }}</label>
                    <input type="text" id="line-vat-rate" name="vat_rate" value="20.00" required>
                </p>
                <button type="submit">{{ 'order.line.add'|trans }}</button>
            </form>
        {% endif %}
    </section>

    <section class="panel">
        <h2>{{ 'order.detail.totals'|trans }}</h2>
        <dl class="kv">
            <dt>{{ 'order.detail.total_excl'|trans }}</dt><dd class="numeric">{{ order.totalExcl }}</dd>
            {% for slice in ventilation %}
                <dt>{{ 'order.detail.vat_at'|trans({'rate': slice.rate}) }}</dt><dd class="numeric">{{ slice.amount }}</dd>
            {% endfor %}
            <dt>{{ 'order.detail.total_incl'|trans }}</dt><dd class="numeric">{{ order.totalIncl }}</dd>
        </dl>
    </section>

    {% if canInvoice and order.validated %}
        <section class="panel">
            <h2>{{ 'order.detail.invoice'|trans }}</h2>
            <p class="field-hint">{{ 'order.detail.invoice_hint'|trans }}</p>
            <form method="post" action="{{ url('order.invoice', {'id': order.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="primary">{{ 'order.detail.invoice'|trans }}</button>
            </form>
        </section>
    {% endif %}

    {% if canManage and order.draft %}
        <section class="panel">
            <h2>{{ 'order.detail.validate'|trans }}</h2>
            <p class="field-hint">{{ 'order.detail.validate_hint'|trans }}</p>
            <form method="post" action="{{ url('order.validate', {'id': order.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="primary">{{ 'order.detail.validate'|trans }}</button>
            </form>
        </section>

        <section class="danger-zone">
            <h2>{{ 'order.detail.danger'|trans }}</h2>
            <form method="post" action="{{ url('order.delete', {'id': order.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="danger">{{ 'order.detail.delete'|trans }}</button>
            </form>
        </section>
    {% endif %}

    <p><a href="{{ url('order.list') }}">{{ 'order.detail.back'|trans }}</a></p>
{% endblock %}
