{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ thirdparty.name }} — {{ 'thirdparty.detail.title'|trans }}{% endblock %}

{% block content %}
    <h1>
        {{ thirdparty.name }} <code>{{ thirdparty.code }}</code>
        {% if not thirdparty.active %}<span class="badge badge-inactive">{{ 'thirdparty.list.inactive'|trans }}</span>{% endif %}
    </h1>

    <p>
        {% if thirdparty.customer %}<span class="badge">{{ 'thirdparty.kind.customer'|trans }}</span>{% endif %}
        {% if thirdparty.supplier %}<span class="badge">{{ 'thirdparty.kind.supplier'|trans }}</span>{% endif %}
        {% if not thirdparty.customer and not thirdparty.supplier %}{{ 'thirdparty.kind.prospect'|trans }}{% endif %}
        {% if thirdparty.alias %} — <em>{{ thirdparty.alias }}</em>{% endif %}
    </p>

    <dl>
        {% if thirdparty.email %}<dt>{{ 'thirdparty.field.email'|trans }}</dt><dd>{{ thirdparty.email }}</dd>{% endif %}
        {% if thirdparty.phone %}<dt>{{ 'thirdparty.field.phone'|trans }}</dt><dd>{{ thirdparty.phone }}</dd>{% endif %}
        {% if thirdparty.address or thirdparty.zip or thirdparty.town %}
            <dt>{{ 'thirdparty.field.address'|trans }}</dt>
            <dd>{{ thirdparty.address }}{% if thirdparty.zip or thirdparty.town %}, {{ thirdparty.zip }} {{ thirdparty.town }}{% endif %}{% if thirdparty.countryCode %} ({{ thirdparty.countryCode }}){% endif %}</dd>
        {% endif %}
        {% if thirdparty.vatNumber %}<dt>{{ 'thirdparty.field.vat'|trans }}</dt><dd>{{ thirdparty.vatNumber }}</dd>{% endif %}
        {% if thirdparty.notes %}<dt>{{ 'thirdparty.field.notes'|trans }}</dt><dd>{{ thirdparty.notes|nl2br }}</dd>{% endif %}
    </dl>

    <p><a href="{{ url('thirdparty.list') }}">{{ 'thirdparty.detail.back'|trans }}</a></p>
{% endblock %}
