{% extends '@liminal/layout.html.twig' %}
{% import '@liminal/components.html.twig' as ui %}

{% block title %}{{ 'thirdparty.list.title'|trans }}{% endblock %}

{% block page_actions %}
    {% if canManage %}<a href="{{ url('thirdparty.create') }}">{{ 'thirdparty.list.create'|trans }}</a>{% endif %}
{% endblock %}

{% block content %}
    <h1>{{ 'thirdparty.list.title'|trans }}</h1>

    {{ ui.toolbar('thirdparty.list', list, schema) }}

    {% if page.total == 0 %}
        {# A filtered list that finds nothing is not an empty list: the first
           invites you to create, the second to widen. #}
        {{ ui.empty_state('contact-round', list.isFiltered ? 'list.no_match'|trans : 'thirdparty.list.empty'|trans) }}
    {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    {{ ui.sortable('thirdparty.list', list, schema, 'code', 'thirdparty.list.code'|trans) }}
                    {{ ui.sortable('thirdparty.list', list, schema, 'name', 'thirdparty.list.name'|trans) }}
                    <th>{{ 'thirdparty.list.kind'|trans }}</th>
                    {{ ui.sortable('thirdparty.list', list, schema, 'town', 'thirdparty.field.town'|trans) }}
                    <th>{{ 'thirdparty.list.status'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for thirdparty in page.items %}
                    <tr>
                        <td><a href="{{ url('thirdparty.detail', {'id': thirdparty.id}) }}">{{ thirdparty.code }}</a></td>
                        <td>
                            {{ thirdparty.name }}
                            {% if thirdparty.alias %} <em>({{ thirdparty.alias }})</em>{% endif %}
                        </td>
                        <td>
                            {% if thirdparty.customer %}<span class="badge">{{ 'thirdparty.kind.customer'|trans }}</span>{% endif %}
                            {% if thirdparty.supplier %}<span class="badge">{{ 'thirdparty.kind.supplier'|trans }}</span>{% endif %}
                            {% if not thirdparty.customer and not thirdparty.supplier %}{{ 'thirdparty.kind.prospect'|trans }}{% endif %}
                        </td>
                        <td>{{ thirdparty.town|default('—') }}</td>
                        <td>
                            {% if not thirdparty.active %}<span class="badge badge-inactive">{{ 'thirdparty.list.inactive'|trans }}</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {{ ui.pagination('thirdparty.list', page, list, schema) }}
    {% endif %}
{% endblock %}
