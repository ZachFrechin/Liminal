{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ 'invoice.create.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ 'invoice.create.title'|trans }}</h1>

    <form method="post" action="{{ url('invoice.create_submit') }}" class="form-card">
        {{ csrf_field() }}

        <p class="field">
            <label for="thirdparty_id">{{ 'invoice.create.thirdparty'|trans }}</label>
            <select id="thirdparty_id" name="thirdparty_id" required>
                {% for thirdparty in thirdparties %}
                    <option value="{{ thirdparty.id }}">{{ thirdparty.name }} ({{ thirdparty.code }})</option>
                {% endfor %}
            </select>
            {% if thirdparties is empty %}
                <span class="field-hint">{{ 'invoice.create.no_thirdparties'|trans }}</span>
            {% endif %}
        </p>
        <div class="field-row">
            <p class="field">
                <label for="issued_on">{{ 'invoice.create.issued_on'|trans }}</label>
                <input type="date" id="issued_on" name="issued_on" value="{{ today }}" required>
            </p>
            <p class="field">
                <label for="due_on">{{ 'invoice.create.due_on'|trans }}</label>
                <input type="date" id="due_on" name="due_on">
            </p>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary">{{ 'invoice.create.submit'|trans }}</button>
        </div>
    </form>
{% endblock %}
