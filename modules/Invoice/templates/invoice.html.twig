{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ invoice.number ?? 'invoice.status.draft'|trans }} — {{ 'invoice.detail.title'|trans }}{% endblock %}

{% block page_actions %}
    <a href="{{ url('invoice.list') }}">{{ 'invoice.detail.back'|trans }}</a>
{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>
            {% if invoice.number %}<code class="entity-code">{{ invoice.number }}</code>{% else %}{{ 'invoice.detail.draft_title'|trans }}{% endif %}
            {% if invoice.draft %}
                <span class="badge">{{ 'invoice.status.draft'|trans }}</span>
            {% else %}
                <span class="badge badge-validated">{{ 'invoice.status.validated'|trans }}</span>
            {% endif %}
        </h1>
        <p class="page-header-meta">
            {% if thirdpartyName %}{{ thirdpartyName }}{% endif %}
            <span>{{ 'invoice.detail.issued'|trans }} {{ invoice.issuedOn|date('Y-m-d') }}</span>
            {% if invoice.dueOn %}<span>{{ 'invoice.detail.due'|trans }} {{ invoice.dueOn|date('Y-m-d') }}</span>{% endif %}
            <a href="{{ url('invoice.pdf', {'id': invoice.id}) }}">
                {%- if invoice.draft %}{{ 'invoice.detail.pdf_proforma'|trans }}{% else %}{{ 'invoice.detail.pdf'|trans }}{% endif -%}
            </a>
        </p>
    </header>

    {% if canManage and invoice.draft %}
        <section class="panel">
            <h2>{{ 'invoice.detail.edit'|trans }}</h2>
            <form class="form-stack" method="post" action="{{ url('invoice.update', {'id': invoice.id}) }}">
                {{ csrf_field() }}
                <p class="field">
                    <label for="thirdparty_id">{{ 'invoice.create.thirdparty'|trans }}</label>
                    <select id="thirdparty_id" name="thirdparty_id" required>
                        {% for thirdparty in thirdparties %}
                            <option value="{{ thirdparty.id }}" {% if thirdparty.id == invoice.thirdpartyId %}selected{% endif %}>{{ thirdparty.name }} ({{ thirdparty.code }})</option>
                        {% endfor %}
                    </select>
                </p>
                <div class="field-row">
                    <p class="field">
                        <label for="issued_on">{{ 'invoice.create.issued_on'|trans }}</label>
                        <input type="date" id="issued_on" name="issued_on" value="{{ invoice.issuedOn|date('Y-m-d') }}" required>
                    </p>
                    <p class="field">
                        <label for="due_on">{{ 'invoice.create.due_on'|trans }}</label>
                        <input type="date" id="due_on" name="due_on" value="{{ invoice.dueOn ? invoice.dueOn|date('Y-m-d') : '' }}">
                    </p>
                </div>
                <div class="form-actions">
                    <button type="submit" class="primary">{{ 'invoice.detail.save'|trans }}</button>
                </div>
            </form>
        </section>
    {% endif %}

    <section class="panel">
        <h2>{{ 'invoice.detail.lines'|trans }}</h2>
        <table>
            <thead>
                <tr>
                    <th>{{ 'invoice.line.label'|trans }}</th>
                    <th>{{ 'invoice.line.quantity'|trans }}</th>
                    <th>{{ 'invoice.line.unit_price'|trans }}</th>
                    <th>{{ 'invoice.line.vat_rate'|trans }}</th>
                    <th>{{ 'invoice.line.total'|trans }}</th>
                    {% if canManage and invoice.draft %}<th></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td>{{ line.label }}</td>
                        <td class="numeric">{{ line.quantity }}</td>
                        <td class="numeric">{{ line.unitPrice }}</td>
                        <td class="numeric">{{ line.vatRate }}&nbsp;%</td>
                        <td class="numeric">{{ lineTotals[line.id]|default('—') }}</td>
                        {% if canManage and invoice.draft %}
                            <td>
                                <form method="post" action="{{ url('invoice.line_remove', {'id': invoice.id, 'line': line.id}) }}">
                                    {{ csrf_field() }}
                                    <button type="submit">{{ 'invoice.line.remove'|trans }}</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr><td colspan="{{ canManage and invoice.draft ? 6 : 5 }}">{{ 'invoice.detail.no_lines'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>

        {% if canManage and invoice.draft %}
            <form method="post" action="{{ url('invoice.line_add', {'id': invoice.id}) }}" class="form-inline">
                {{ csrf_field() }}
                <p class="field">
                    <label for="line-label">{{ 'invoice.line.label'|trans }}</label>
                    <input type="text" id="line-label" name="label" maxlength="255" required>
                </p>
                <p class="field">
                    <label for="line-quantity">{{ 'invoice.line.quantity'|trans }}</label>
                    <input type="text" id="line-quantity" name="quantity" value="1" required>
                </p>
                <p class="field">
                    <label for="line-unit-price">{{ 'invoice.line.unit_price'|trans }}</label>
                    <input type="text" id="line-unit-price" name="unit_price" required>
                </p>
                <p class="field">
                    <label for="line-vat-rate">{{ 'invoice.line.vat_rate'|trans }}</label>
                    <input type="text" id="line-vat-rate" name="vat_rate" value="20.00" required>
                </p>
                <button type="submit">{{ 'invoice.line.add'|trans }}</button>
            </form>
        {% endif %}
    </section>

    <section class="panel">
        <h2>{{ 'invoice.detail.totals'|trans }}</h2>
        <dl class="kv">
            <dt>{{ 'invoice.detail.total_excl'|trans }}</dt><dd class="numeric">{{ invoice.totalExcl }}</dd>
            {% for slice in ventilation %}
                <dt>{{ 'invoice.detail.vat_at'|trans({'rate': slice.rate}) }}</dt><dd class="numeric">{{ slice.amount }}</dd>
            {% endfor %}
            <dt>{{ 'invoice.detail.total_incl'|trans }}</dt><dd class="numeric">{{ invoice.totalIncl }}</dd>
        </dl>
    </section>

    {% if canManage and invoice.draft %}
        <section class="panel">
            <h2>{{ 'invoice.detail.validate'|trans }}</h2>
            <p class="field-hint">{{ 'invoice.detail.validate_hint'|trans }}</p>
            <form method="post" action="{{ url('invoice.validate', {'id': invoice.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="primary">{{ 'invoice.detail.validate'|trans }}</button>
            </form>
        </section>

        <section class="danger-zone">
            <h2>{{ 'invoice.detail.danger'|trans }}</h2>
            <form method="post" action="{{ url('invoice.delete', {'id': invoice.id}) }}">
                {{ csrf_field() }}
                <button type="submit" class="danger">{{ 'invoice.detail.delete'|trans }}</button>
            </form>
        </section>
    {% endif %}
{% endblock %}
