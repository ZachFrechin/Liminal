{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ invoice.number ?? 'invoice.status.draft'|trans }} — {{ 'invoice.detail.title'|trans }}{% endblock %}

{% block content %}
    <header class="page-header">
        <h1>
            {% if invoice.number %}<code class="entity-code">{{ invoice.number }}</code>{% else %}{{ 'invoice.detail.draft_title'|trans }}{% endif %}
            {% if invoice.draft %}
                <span class="badge">{{ 'invoice.status.draft'|trans }}</span>
            {% else %}
                <span class="badge badge-validated">{{ 'invoice.status.validated'|trans }}</span>
            {% endif %}
        </h1>
        <p class="page-header-meta">
            {% if thirdpartyName %}{{ thirdpartyName }}{% endif %}
            <span>{{ 'invoice.detail.issued'|trans }} {{ invoice.issuedOn|date('Y-m-d') }}</span>
            {% if invoice.dueOn %}<span>{{ 'invoice.detail.due'|trans }} {{ invoice.dueOn|date('Y-m-d') }}</span>{% endif %}
        </p>
    </header>

    <section class="panel">
        <h2>{{ 'invoice.detail.lines'|trans }}</h2>
        <table>
            <thead>
                <tr>
                    <th>{{ 'invoice.line.label'|trans }}</th>
                    <th>{{ 'invoice.line.quantity'|trans }}</th>
                    <th>{{ 'invoice.line.unit_price'|trans }}</th>
                    <th>{{ 'invoice.line.vat_rate'|trans }}</th>
                    <th>{{ 'invoice.line.total'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td>{{ line.label }}</td>
                        <td class="numeric">{{ line.quantity }}</td>
                        <td class="numeric">{{ line.unitPrice }}</td>
                        <td class="numeric">{{ line.vatRate }}&nbsp;%</td>
                        <td class="numeric">{{ lineTotals[line.id]|default('—') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">{{ 'invoice.detail.no_lines'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="panel">
        <h2>{{ 'invoice.detail.totals'|trans }}</h2>
        <dl class="kv">
            <dt>{{ 'invoice.detail.total_excl'|trans }}</dt><dd class="numeric">{{ invoice.totalExcl }}</dd>
            {% for slice in ventilation %}
                <dt>{{ 'invoice.detail.vat_at'|trans({'rate': slice.rate}) }}</dt><dd class="numeric">{{ slice.amount }}</dd>
            {% endfor %}
            <dt>{{ 'invoice.detail.total_incl'|trans }}</dt><dd class="numeric">{{ invoice.totalIncl }}</dd>
        </dl>
    </section>

    <p><a href="{{ url('invoice.list') }}">{{ 'invoice.detail.back'|trans }}</a></p>
{% endblock %}
