{% extends '@liminal/layout.html.twig' %}
{% import '@liminal/components.html.twig' as ui %}

{% block title %}{{ 'invoice.list.title'|trans }}{% endblock %}

{% block page_actions %}
    {% if canManage %}<a href="{{ url('invoice.create') }}">{{ 'invoice.list.create'|trans }}</a>{% endif %}
{% endblock %}

{% block content %}
    <h1>{{ 'invoice.list.title'|trans }}</h1>

    {{ ui.toolbar('invoice.list', list, schema) }}

    {% if page.total == 0 %}
        {# A filtered list that finds nothing is not an empty list. #}
        {{ ui.empty_state('receipt-text', list.isFiltered ? 'list.no_match'|trans : 'invoice.list.empty'|trans) }}
    {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    {{ ui.sortable('invoice.list', list, schema, 'number', 'invoice.list.number'|trans) }}
                    {{ ui.sortable('invoice.list', list, schema, 'party', 'invoice.list.party'|trans) }}
                    {{ ui.sortable('invoice.list', list, schema, 'issued', 'invoice.list.issued'|trans) }}
                    {{ ui.sortable('invoice.list', list, schema, 'status', 'invoice.list.status'|trans) }}
                    {{ ui.sortable('invoice.list', list, schema, 'total', 'invoice.list.total'|trans) }}
                </tr>
            </thead>
            <tbody>
                {% for invoice in page.items %}
                    <tr>
                        <td>
                            <a href="{{ url('invoice.detail', {'id': invoice.id}) }}">
                                {%- if invoice.number %}{{ invoice.number }}{% else %}{{ 'invoice.status.draft'|trans }}{% endif -%}
                            </a>
                        </td>
                        <td>{{ thirdpartyNames[invoice.thirdpartyId]|default('—') }}</td>
                        <td>{{ invoice.issuedOn|date('Y-m-d') }}</td>
                        <td>
                            {% if invoice.draft %}
                                <span class="badge">{{ 'invoice.status.draft'|trans }}</span>
                            {% else %}
                                <span class="badge badge-validated">{{ 'invoice.status.validated'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="numeric">{{ invoice.totalIncl }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {{ ui.pagination('invoice.list', page, list, schema) }}
    {% endif %}
{% endblock %}
