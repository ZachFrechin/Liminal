{# The base shell every page extends. Deliberately spartan: semantic HTML,
   one embedded style block, no framework — restyle at will. No template in
   this tree may ever use |raw: autoescaping is the XSS story. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Liminal{% endblock %}</title>
    {% block head %}
    <style>
        :root { color-scheme: light dark; }
        body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; }
        header { border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent); padding: .75rem 1.25rem; display: flex; gap: 1.5rem; align-items: baseline; }
        header strong { font-size: 1.05rem; }
        main { padding: 1.25rem; max-width: 60rem; }
        nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; }
        nav ul ul { display: block; margin-left: 1rem; }
        footer { padding: .75rem 1.25rem; opacity: .6; font-size: .85rem; }
    </style>
    {% endblock %}
</head>
<body>
<header>
    <strong>Liminal</strong>
    {% block header %}{% endblock %}
</header>
<main>
    {% block flash %}{% endblock %}
    {% block content %}{% endblock %}
</main>
<footer>{% block footer %}{% endblock %}</footer>
</body>
</html>
