{# The base shell every page extends. Deliberately spartan: semantic HTML,
   one embedded style block, no framework — restyle at will. No template in
   this tree may ever use |raw: autoescaping is the XSS story. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Liminal{% endblock %}</title>
    {% block head %}
    <style>
        :root { color-scheme: light dark; }
        body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.5; }
        header { border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent); padding: .75rem 1.25rem; display: flex; gap: 1.5rem; align-items: baseline; }
        header strong { font-size: 1.05rem; }
        main { padding: 1.25rem; max-width: 60rem; }
        nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; }
        nav ul ul { display: block; margin-left: 1rem; }
        footer { padding: .75rem 1.25rem; opacity: .6; font-size: .85rem; }
    </style>
    {% endblock %}
</head>
<body>
<header>
    <strong>Liminal</strong>
    {% set user = current_user() %}
    {% if user %}<span class="user">{{ user.displayName }}</span>{% endif %}
    {% block menu %}
        <nav>{% include '@liminal/_menu.html.twig' with {'nodes': menu()} only %}</nav>
    {% endblock %}
    {% block header %}{% endblock %}
</header>
<main>
    {% block flash %}
        {# Handlers flash catalogue KEYS, translated here so the language is
           the reader's at render time; free text degrades through |trans
           unchanged, because a missing key resolves to itself. #}
        {% set flash_success = flash('success') %}
        {% if flash_success %}<p class="flash flash-success" role="status">{{ flash_success|trans }}</p>{% endif %}
        {% set flash_error = flash('error') %}
        {% if flash_error %}<p class="flash flash-error" role="alert">{{ flash_error|trans }}</p>{% endif %}
    {% endblock %}
    {% block content %}{% endblock %}
</main>
<footer>{% block footer %}{% endblock %}</footer>
</body>
</html>
