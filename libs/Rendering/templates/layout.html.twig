{# The application shell every page extends. One skeleton, two faces: an
   authenticated request gets the sidebar (company switcher, navigation) and
   the topbar (working company, user menu); an anonymous one gets a centered
   card under the wordmark. Dropdowns are native <details> — no JavaScript
   anywhere. No template in this tree may ever use |raw: autoescaping is the
   XSS story.

   The two action blocks exist for the unwind path: error pages extend this
   layout, and error templates must never carry a form (a token minted there
   reaches the HTML but never the store). error.html.twig overrides both
   blocks empty — chrome stays, forms disappear. #}
{% import '@liminal/components.html.twig' as ui %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Liminal{% endblock %}</title>
    {% block head %}
    <link rel="stylesheet" href="{{ asset('css/liminal.css') }}">
    {% endblock %}
</head>
{% set _liminal_user = current_user() %}
<body class="{{ _liminal_user ? 'shell' : 'anon' }}">
{% if _liminal_user %}
    {% set _liminal_companies = accessible_companies() %}
    <nav class="sidebar">
        {% block sidebar_actions %}
            <details class="company-switcher">
                <summary>
                    {% for company in _liminal_companies %}{% if company.current %}<span class="monogram">{{ company.code|slice(0, 2) }}</span><span class="switcher-label">{{ company.name }}</span>{% endif %}{% endfor %}
                    {{ icon('chevrons-up-down', 14) }}
                </summary>
                <div class="switcher-panel">
                    {% set switching = company_switching() %}
                    {% for company in _liminal_companies %}
                        {% if company.current %}
                            <span class="switcher-row is-current"><span class="monogram monogram-sm">{{ company.code|slice(0, 2) }}</span>{{ company.name }}{{ icon('check', 14) }}</span>
                        {% elseif switching %}
                            <form method="post" action="{{ url('authentication.switch') }}">
                                {{ csrf_field() }}
                                <input type="hidden" name="company" value="{{ company.id }}">
                                <button type="submit" class="switcher-row"><span class="monogram monogram-sm">{{ company.code|slice(0, 2) }}</span>{{ company.name }}</button>
                            </form>
                        {% else %}
                            {# The switch route belongs to the authentication module: disabled
                               for the working company its POST answers 404 — names stay, forms go. #}
                            <span class="switcher-row">{{ company.name }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
            </details>
        {% endblock %}
        <div class="sidebar-nav">
            {% block menu %}
                <nav>{% include '@liminal/_menu.html.twig' with {'nodes': menu()} only %}</nav>
            {% endblock %}
        </div>
        <div class="sidebar-foot">Liminal</div>
    </nav>
{% endif %}
<div class="frame">
    {% if _liminal_user %}
        <header class="topbar">
            {% for company in _liminal_companies %}{% if company.current %}<span class="topbar-context">{{ company.name }}</span>{% endif %}{% endfor %}
            {% block header %}{% endblock %}
            {% block topbar_actions %}
                <details class="user-menu">
                    <summary><span class="avatar">{{ _liminal_user.displayName|slice(0, 1)|upper }}</span><span class="user-name">{{ _liminal_user.displayName }}</span>{{ icon('chevron-down', 13) }}</summary>
                    <div class="user-menu-panel">
                        {% if route_exists('authentication.account') %}
                            <a href="{{ url('authentication.account') }}">{{ icon('user-round', 14) }}{{ 'authentication.menu.account'|trans }}</a>
                        {% endif %}
                        {% if route_exists('authentication.logout') %}
                            <form method="post" action="{{ url('authentication.logout') }}">
                                {{ csrf_field() }}
                                <button type="submit">{{ icon('log-out', 14) }}{{ 'authentication.account.sign_out'|trans }}</button>
                            </form>
                        {% endif %}
                    </div>
                </details>
            {% endblock %}
        </header>
        {# Page navigation and page actions, always in the same place and never
           scrolled away: a back link at the bottom of a long document was a
           different place on every screen. The THIRD form region — document
           actions live here — so the error page empties it like the other
           two. Inside the authenticated branch: an empty band above the
           sign-in card would be chrome with nothing to say. #}
        <div class="subbar">{% block page_actions %}{% endblock %}</div>
    {% else %}
        <div class="anon-brand"><span class="monogram">L</span><span class="wordmark">Liminal</span></div>
    {% endif %}
    {# tabindex: the content column is the only scroller now, and a scroller
       that cannot take focus is a scroller Space and PageDown cannot reach
       in Firefox and Safari. #}
    <main tabindex="-1">
        {% block flash %}
            {# Handlers flash catalogue KEYS, translated here so the language is
               the reader's at render time; free text degrades through |trans
               unchanged, because a missing key resolves to itself. Flashes are
               banners — the in-flow voice — on both faces of the shell. #}
            {% set flash_success = flash('success') %}
            {% if flash_success %}{{ ui.banner('success', flash_success|trans) }}{% endif %}
            {% set flash_error = flash('error') %}
            {% if flash_error %}{{ ui.banner('danger', flash_error|trans) }}{% endif %}
        {% endblock %}
        {% block content %}{% endblock %}
    </main>
    {# The region exists only when something fills it: an always-empty band
       was harmless while the page scrolled past it, and would be permanent
       chrome now that the shell holds still. #}
    {% if block('footer')|trim is not empty %}
        <footer>{% block footer %}{% endblock %}</footer>
    {% endif %}
</div>
</body>
</html>
