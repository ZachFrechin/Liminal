{# Carries no form on purpose: this page renders on the unwind path, where the
   session is never persisted, so any token minted here would be a lie. #}
{% extends '@liminal/layout.html.twig' %}

{% block title %}{{ status }} — {{ 'error.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ status }}</h1>
    <p>{{ message }}</p>
    <p><a href="/">{{ 'error.back'|trans }}</a></p>
{% endblock %}
