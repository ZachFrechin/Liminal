<?php

declare(strict_types=1);

namespace Liminal\Module\{{Studly}}\Http;

use Liminal\Lib\Rendering\HtmlRenderer;
use Liminal\Lib\Security\Authorization\Gate;
use Liminal\Lib\Security\Authorization\RequestGate;
use Liminal\Module\{{Studly}}\Repository\{{Studly}}Repository;
use Psr\Http\Message\ResponseInterface;
use Psr\Http\Message\ServerRequestInterface;
use Psr\Http\Server\RequestHandlerInterface;

/**
 * The {{slug}}s of the working company, searchable, one page at a time.
 * The section's two permissions anchor here: read opens the pages, manage
 * opens the writes — and manage PRESUMES read (every handler authorizes
 * read first).
 */
final readonly class {{Studly}}ListHandler implements RequestHandlerInterface
{
    public const string READ = '{{slug}}.read';

    public const string MANAGE = '{{slug}}.manage';

    public function __construct(
        private HtmlRenderer $html,
        private RequestGate $gate,
        private Gate $allows,
        private {{Studly}}Repository $records,
    ) {}

    public function handle(ServerRequestInterface $request): ResponseInterface
    {
        $this->gate->authorize(self::READ);

        $params = $request->getQueryParams();
        $requestedPage = is_numeric($params['page'] ?? null) ? (int) $params['page'] : 1;
        $query = is_string($params['q'] ?? null) ? $params['q'] : null;

        return $this->html->respond(
            '@{{slug}}/{{slug}}s.html.twig',
            [
                'page' => $this->records->page($requestedPage, $query),
                'query' => trim($query ?? ''),
                'canManage' => $this->allows->allows(self::MANAGE),
            ],
            200,
            ['Cache-Control' => 'no-store'],
        );
    }
}
