{% extends '@liminal/layout.html.twig' %}
{% import '@liminal/components.html.twig' as ui %}

{% block title %}{{ '{{slug}}.list.title'|trans }}{% endblock %}

{% block content %}
    <h1>{{ '{{slug}}.list.title'|trans }}</h1>

    {% if canManage %}
        <p><a href="{{ url('{{slug}}.create') }}">{{ '{{slug}}.list.create'|trans }}</a></p>
    {% endif %}

    <form method="get" action="{{ url('{{slug}}.list') }}">
        <input type="search" name="q" value="{{ query }}" placeholder="{{ '{{slug}}.list.search'|trans }}">
        <button type="submit">{{ '{{slug}}.list.search'|trans }}</button>
    </form>

    {% if page.total == 0 %}
        {{ ui.empty_state('{{icon}}', '{{slug}}.list.empty'|trans) }}
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>{{ '{{slug}}.list.code'|trans }}</th>
                    <th>{{ '{{slug}}.list.name'|trans }}</th>
                    <th>{{ '{{slug}}.list.status'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for record in page.items %}
                    <tr>
                        <td><a href="{{ url('{{slug}}.detail', {'id': record.id}) }}"><code class="entity-code">{{ record.code }}</code></a></td>
                        <td>{{ record.name }}</td>
                        <td>
                            {% if record.active %}
                                <span class="badge">{{ '{{slug}}.status.active'|trans }}</span>
                            {% else %}
                                <span class="badge badge-inactive">{{ '{{slug}}.status.inactive'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="pagination">
            {{ '{{slug}}.list.page_of'|trans({'page': page.page, 'pages': page.pages, 'total': page.total}) }}
            {% if page.hasPrevious %}<a href="{{ url('{{slug}}.list') }}?page={{ page.page - 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}">&larr;</a>{% endif %}
            {% if page.hasNext %}<a href="{{ url('{{slug}}.list') }}?page={{ page.page + 1 }}{% if query %}&q={{ query|url_encode }}{% endif %}">&rarr;</a>{% endif %}
        </p>
    {% endif %}
{% endblock %}
