<?php

declare(strict_types=1);

namespace Liminal\Module\{{Studly}}\Http;

use Liminal\Http\Exception\HttpException;
use Liminal\Http\UrlGenerator;
use Liminal\Lib\Hook\Hooks;
use Liminal\Lib\Hook\Triggers;
use Liminal\Lib\Security\Authorization\RequestGate;
use Liminal\Lib\Security\Session\Session;
use Liminal\Lib\Security\Session\SessionMiddleware;
use Liminal\Module\{{Studly}}\Exception\{{Studly}}ModuleException;
use Liminal\Module\{{Studly}}\Repository\{{Studly}}Repository;
use Psr\Http\Message\ResponseFactoryInterface;
use Psr\Http\Message\ResponseInterface;
use Psr\Http\Message\ServerRequestInterface;
use Psr\Http\Server\RequestHandlerInterface;

/**
 * Deletes a {{slug}} — after asking the rest of the system: the
 * {{slug}}.deletion.veto dispatch lets any module holding records naming
 * this one answer with a refusal reason, without this module ever learning
 * who. The declarer validates the returned shape; the flash shows the first
 * reason.
 */
final readonly class {{Studly}}DeleteHandler implements RequestHandlerInterface
{
    public function __construct(
        private RequestGate $gate,
        private {{Studly}}Repository $records,
        private Hooks $hooks,
        private UrlGenerator $urls,
        private ResponseFactoryInterface $responses,
        private Triggers $triggers,
    ) {}

    /**
     * @throws HttpException as notFound() when no such {{slug}} exists here
     */
    public function handle(ServerRequestInterface $request): ResponseInterface
    {
        $this->gate->authorize({{Studly}}ListHandler::READ);
        $this->gate->authorize({{Studly}}ListHandler::MANAGE);

        $session = $request->getAttribute(SessionMiddleware::ATTRIBUTE);

        if (!$session instanceof Session) {
            throw {{Studly}}ModuleException::sessionMissing();
        }

        $raw = $request->getAttribute('id');
        $id = is_numeric($raw) ? (int) $raw : 0;

        $record = $this->records->byId($id);

        if ($record === null) {
            throw HttpException::notFound($request->getUri()->getPath());
        }

        $code = $record->getCode();

        $reasons = $this->hooks->filter('{{slug}}.deletion.veto', [], ['{{slug}}_id' => $id]);

        if (!is_array($reasons) || !array_is_list($reasons) || $reasons !== array_filter($reasons, is_string(...))) {
            throw {{Studly}}ModuleException::malformedVeto(get_debug_type($reasons));
        }

        if ($reasons !== []) {
            $session->set('error', $reasons[0]);

            return $this->responses->createResponse(302)
                ->withHeader('Location', $this->urls->generate('{{slug}}.detail', ['id' => $id]));
        }

        $this->records->remove($record);
        $this->records->flush();

        $this->triggers->fire('{{SCREAMING}}_DELETED', ['{{slug}}_id' => $id, 'code' => $code]);
        $session->set('success', '{{slug}}.form.deleted');

        return $this->responses->createResponse(302)
            ->withHeader('Location', $this->urls->generate('{{slug}}.list'));
    }
}
