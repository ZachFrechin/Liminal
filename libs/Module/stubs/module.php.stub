<?php

declare(strict_types=1);

namespace Liminal\Module\{{Studly}};

use Liminal\Module\{{Studly}}\Http\{{Studly}}CreatePageHandler;
use Liminal\Module\{{Studly}}\Http\{{Studly}}CreateSubmitHandler;
use Liminal\Module\{{Studly}}\Http\{{Studly}}DeleteHandler;
use Liminal\Module\{{Studly}}\Http\{{Studly}}DetailHandler;
use Liminal\Module\{{Studly}}\Http\{{Studly}}ListHandler;
use Liminal\Module\{{Studly}}\Http\{{Studly}}UpdateHandler;
use Liminal\Registry\Contract\Module;
use Liminal\Registry\EntityRegistry;
use Liminal\Registry\HookRegistry;
use Liminal\Registry\MenuItem;
use Liminal\Registry\MenuRegistry;
use Liminal\Registry\MigrationRegistry;
use Liminal\Registry\Permission;
use Liminal\Registry\PermissionRegistry;
use Liminal\Registry\RegistryCollection;
use Liminal\Registry\RouteRegistry;
use Liminal\Registry\TemplateRegistry;
use Liminal\Registry\TranslationRegistry;
use Liminal\Registry\TriggerRegistry;

/**
 * The {{slug}} module: generated by module:create as a complete CRUD
 * vertical — grow it from here. Everything it does goes through registries;
 * it never touches the core.
 */
final class {{Studly}}Module implements Module
{
    /** The module's identity: its name, its route prefix and its template namespace. */
    public const string NAME = '{{slug}}';

    public const string MIGRATION_NAMESPACE = 'Liminal\Module\{{Studly}}\Migrations';

    public const string ENTITY_NAMESPACE = 'Liminal\Module\{{Studly}}\Entity';

    public function name(): string
    {
        return self::NAME;
    }

    public function version(): string
    {
        return '0.1.0';
    }

    public function migrationNamespace(): string
    {
        return self::MIGRATION_NAMESPACE;
    }

    public function contribute(RegistryCollection $registries): void
    {
        $registries->get(MigrationRegistry::class)
            ->add(self::MIGRATION_NAMESPACE, __DIR__ . '/Migrations');

        // Business reads and writes go through the ORM, because the company
        // fence only exists there.
        $registries->get(EntityRegistry::class)
            ->add(self::ENTITY_NAMESPACE, __DIR__ . '/Entity');

        $registries->get(TemplateRegistry::class)
            ->add(self::NAME, __DIR__ . '/templates');

        $registries->get(TranslationRegistry::class)
            ->add('en', __DIR__ . '/lang/en.php');

        // Statics before dynamics, and {id:\d+} is load-bearing.
        $routes = $registries->get(RouteRegistry::class);
        $routes->get('/{{slug}}s', {{Studly}}ListHandler::class, '{{slug}}.list');
        $routes->get('/{{slug}}s/create', {{Studly}}CreatePageHandler::class, '{{slug}}.create');
        $routes->post('/{{slug}}s/create', {{Studly}}CreateSubmitHandler::class, '{{slug}}.create_submit');
        $routes->get('/{{slug}}s/{id:\d+}', {{Studly}}DetailHandler::class, '{{slug}}.detail');
        $routes->post('/{{slug}}s/{id:\d+}', {{Studly}}UpdateHandler::class, '{{slug}}.update');
        $routes->post('/{{slug}}s/{id:\d+}/delete', {{Studly}}DeleteHandler::class, '{{slug}}.delete');

        $registries->get(MenuRegistry::class)->add(new MenuItem(
            '{{slug}}.menu.entries',
            '{{slug}}.list',
            {{Studly}}ListHandler::READ,
            priority: 950,
            icon: '{{icon}}',
        ));

        $permissions = $registries->get(PermissionRegistry::class);
        $permissions->add(new Permission({{Studly}}ListHandler::READ, '{{slug}}.permission.read', self::NAME));
        $permissions->add(new Permission({{Studly}}ListHandler::MANAGE, '{{slug}}.permission.manage', self::NAME));

        // The deletion veto: whoever holds records naming a {{slug}} answers
        // here with a refusal reason — this module never learns who.
        $registries->get(HookRegistry::class)->declare('{{slug}}.deletion.veto');

        $triggers = $registries->get(TriggerRegistry::class);
        $triggers->declare('{{SCREAMING}}_CREATED');
        $triggers->declare('{{SCREAMING}}_UPDATED');
        $triggers->declare('{{SCREAMING}}_DELETED');
    }
}
