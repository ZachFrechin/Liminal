# Liminal environment variables.
#
# There is NO dotenv loader in the core: these are real environment variables,
# exported by your shell, direnv, docker compose or the process manager. This
# file only documents them.

# Database DSN for the application. Unset = the database lib stays dormant
# (boot succeeds, doctor reports SKIP, resolving the EntityManager fails).
#LIMINAL_DSN='mysql://liminal:liminal@127.0.0.1:3306/liminal'

# Database DSN for the integration test suite ONLY. The application never
# reads it, and never falls back onto it.
#LIMINAL_TEST_DSN='mysql://liminal:liminal@127.0.0.1:3306/liminal_test'

# Host port published by `docker compose up -d db` (default 3306). Remap it
# when another MariaDB already holds 3306.
#LIMINAL_DB_PORT=3306

# The company the process starts scoped to before authentication exists
# (default 1, the installer-seeded first company).
#LIMINAL_BOOTSTRAP_COMPANY=1

# Debug mode: error responses expose real exception messages (default true;
# set to 0 in production).
#LIMINAL_DEBUG=1

# Compile the PHP-DI container into var/cache (default false; meant for
# production once module activation rebuilds the cache).
#LIMINAL_COMPILE=0
